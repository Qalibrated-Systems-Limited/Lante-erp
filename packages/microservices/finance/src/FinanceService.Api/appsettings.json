{
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}"
  },
  "JWT": {
    "SecretKey": "${JWT__SecretKey}",
    "Issuer": "LanteUserService",
    "Audience": "LanteUserService"
  },
  "Finance": {
    "EnforceApprovalAuthority": false
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning" } }
  }
}
