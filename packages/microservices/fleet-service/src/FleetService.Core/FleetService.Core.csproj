<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <!-- FieldVehicleService.TryParseInsuranceExpiry is internal and pure so its accepted date
       formats can be pinned without standing up FieldVehicleService itself (7 constructor
       dependencies, no existing test harness) — same reasoning as FleetService.Infrastructure's
       InternalsVisibleTo for ExpiryBand. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FleetService.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- AutoMapper's DoS vulnerability (GHSA-rvv3-g6hj-g44x, unbounded recursion on deeply
       self-referential object graphs) is only patched in 15.1.1+/16.1.1+, which require a
       paid/RPL1.5-licensed release we're deliberately not adopting (staying on the last
       MIT-licensed 14.x line). Mitigated in code instead: every CreateMap<> in this service's
       AutoMapper profile(s) was audited and confirmed not to map a genuinely self-referential
       type graph (see the profile's own review), so the recursion this advisory describes isn't
       reachable here. Suppressing only this specific advisory, not the whole NU1903 code. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
