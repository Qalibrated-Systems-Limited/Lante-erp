{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lante_licensing;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "${JWT__SecretKey}",
    "Issuer": "LanteLicenseService",
    "Audience": "LanteLicenseService"
  },
  "License": {
    "PrivateKeyJwk": ""
  },
  "InternalServices": {
    "ServiceKey": "${InternalServices__ServiceKey}"
  },
  "TicketingService": {
    "BaseUrl": "${TicketingService__BaseUrl}"
  },
  "AllowedHosts": "*"
}
