{
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}"
  },
  "JWT": {
    "SecretKey": "${JWT__SecretKey}",
    "Issuer": "LanteUserService",
    "Audience": "LanteUserService"
  },
  "AllowedHosts": "*",
  "UserService": {
    "BaseUrl": "${UserService__BaseUrl}"
  },
  "FleetService": {
    "BaseUrl": "${FleetService__BaseUrl}"
  },
  "OperationsService": {
    "BaseUrl": "${OperationsService__BaseUrl}"
  },
  "InternalServices": {
    "ServiceKey": "${InternalServices__ServiceKey}"
  },
  "Smtp": {
    "Host": "${Smtp__Host}",
    "Port": "${Smtp__Port}",
    "Username": "${Smtp__Username}",
    "Password": "${Smtp__Password}",
    "From": "${Smtp__From}",
    "FromName": "Lante",
    "Enabled": "${Smtp__Enabled}"
  },
  "Storage": {
    "BasePath": "/app/uploads",
    "BaseUrl": "${Storage__BaseUrl}"
  },
  "Sms": {
    "Enabled": "${Sms__Enabled}",
    "Tiara": {
      "BaseUrl": "${Sms__Tiara__BaseUrl}",
      "ApiKey": "${Sms__Tiara__ApiKey}",
      "SenderId": "${Sms__Tiara__SenderId}"
    }
  }
}
