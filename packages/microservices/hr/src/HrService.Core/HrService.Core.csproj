<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <!-- AutoMapper's DoS vulnerability (GHSA-rvv3-g6hj-g44x, unbounded recursion on deeply
       self-referential object graphs) is only patched in 15.1.1+/16.1.1+, which require a
       paid/RPL1.5-licensed release we're deliberately not adopting (staying on the last
       MIT-licensed 14.x line). Mitigated in code instead: every CreateMap<> in this service's
       AutoMapper profile(s) was audited and confirmed not to map a genuinely self-referential
       type graph (see the profile's own review), so the recursion this advisory describes isn't
       reachable here. Suppressing only this specific advisory, not the whole NU1903 code. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>

  <ItemGroup>
    <!-- The payroll statutory arithmetic (TaxOn, StatutoryAmount, EmployerAmount, Clamp) is pure
         and is the highest-risk logic in this service: a wrong PAYE or NSSF figure is a legal
         problem, not a bug report. Exposed to the test project only so those functions can be
         tested directly rather than through a full payroll run. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>HrService.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
