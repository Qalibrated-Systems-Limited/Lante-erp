{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=lante_stores;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "${JWT__SecretKey}",
    "Issuer": "LanteStoreService",
    "Audience": "LanteStoreService"
  },
  "InternalServices": {
    "ServiceKey": "${InternalServices__ServiceKey}"
  },
  "AllowedHosts": "*"
}
